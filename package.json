{
  "name": "gordian-coder",
  "version": "0.1.0",
  "description": "Multi-platform AI coding assistant plugin for OpenCode, Claude Code, and Cline",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "gordian-coder-mcp": "./dist/adapters/mcp/server.js",
    "gordian-coder-cli": "./dist/adapters/cli/cli.js",
    "gdc": "./dist/adapters/cline/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode": {
      "types": "./dist/adapters/opencode/index.d.ts",
      "import": "./dist/adapters/opencode/index.js"
    },
    "./mcp": {
      "types": "./dist/adapters/mcp/index.d.ts",
      "import": "./dist/adapters/mcp/index.js"
    },
    "./cli": {
      "types": "./dist/adapters/cli/index.d.ts",
      "import": "./dist/adapters/cli/index.js"
    },
    "./cline": {
      "types": "./dist/adapters/cline/index.d.ts",
      "import": "./dist/adapters/cline/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/adapters/mcp/server.ts src/adapters/cli/cli.ts src/adapters/cline/cli.ts --outdir dist --target bun --format esm && tsc --emitDeclarationOnly",
    "start:cline": "bun run src/adapters/cline/cli.ts",
    "start:cli": "bun run src/adapters/cli/cli.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start:mcp": "bun run src/adapters/mcp/server.ts"
  },
  "keywords": [
    "opencode",
    "claude-code",
    "cline",
    "mcp",
    "plugin",
    "ai-coding",
    "gordian-coder"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opencode-ai/plugin": "^1.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.7.3"
  }
}
